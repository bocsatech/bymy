# Supabase (bymy projekt — külön a bocsa-app-tól)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (API Keys → Publishable) vagy legacy anon
SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Secret key (API Keys → Secret) vagy legacy service_role — csak szerveren!
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# Opcionális: automatikus látogató-tábla telepítés (Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Lokálisan SQLite marad az alapértelmezett. Felhő / teszt:
# DB_BACKEND=supabase

# Helyi SQLite (jelenlegi dev szerver)
# DB_BACKEND=sqlite
# AUTOSWEB_DB_PATH=

# Bocsatech admin (level1) — első fiók, csak ha a level1_admins üres
# LEVEL1_BOOTSTRAP_USERNAME=bocsatech
# LEVEL1_BOOTSTRAP_PASSWORD=
# LEVEL1_BOOTSTRAP_EMAIL=te@email.hu
# LEVEL1_DB_PATH=

# Email 2FA (Vercel): Gmail app jelszó vagy más SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bymy <te@email.hu>
