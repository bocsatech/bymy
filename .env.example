# Másold .env.local néven. Forrás: mac/s1-pull-supabase-env.command (S1 / bymy.hu éles DB).
#
# Mac + Vercel: SUPABASE_URL=https://bymy.hu  (nginx proxy → bymy-data)
# S1 szerver:   SUPABASE_URL=http://168.231.110.159:8000  (belső, gyorsabb)
#
# A gyökér .env fájl (Vercel artifact) NE írja felül a Supabase kulcsokat — .env.local az igazság.

SUPABASE_URL=https://bymy.hu
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_URL=https://bymy.hu
PUBLIC_BASE_URL=https://bymy.hu
DB_BACKEND=supabase

# Helyi dev (npm start → http://127.0.0.1:3456)
PORT=3456

# S1 sync scriptekhez
S1_SSH=bymy-app
S1_APP_DIR=/var/www/bymy
S1_ENV=/var/www/bymy/.env
